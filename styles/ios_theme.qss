/* iOS Dark Theme for GoldenNugget */

/* Backgrounds */
QWidget#iosContainer {
    background-color: #000000;
    color: #FFFFFF;
}

/* Cards */
QWidget#iosCard {
    background-color: #1C1C1E;
    border-radius: 14px;
    padding: 16px;
}

/* Navigation Bar */
QWidget#iosNavBar {
    background-color: #000000;
    border-bottom: 1px solid #38383A;
}

/* Section Headers */
QLabel#iosSectionHeader {
    color: #8E8E93;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 16px;
}

/* Settings Rows */
QPushButton#iosSettingsRow {
    background-color: #1C1C1E;
    border-radius: 10px;
    padding: 12px 16px;
    color: #FFFFFF;
    text-align: left;
    font-size: 16px;
}
QPushButton#iosSettingsRow:hover {
    background-color: #2C2C2E;
}

/* Primary Button */
QPushButton#iosPrimaryButton {
    background-color: #007AFF;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 600;
    padding: 14px 24px;
}
QPushButton#iosPrimaryButton:hover {
    background-color: #005ACF;
}

/* Divider */
QFrame#iosDivider {
    color: #38383A;
    height: 1px;
    background-color: #38383A;
}
